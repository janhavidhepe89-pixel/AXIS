# Agent hot wallet (Sepolia). Holds the treasury the agent manages.
AGENT_PRIVATE_KEY=0x...

# Uniswap Trading API key: https://developers.uniswap.org/dashboard/
UNISWAP_API_KEY=

# Sepolia RPC (Alchemy/Infura recommended)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# World ID for Agents (sandbox) OIDC client: http://sandbox.auth.world.org/portal
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=

# Public HTTPS base URL of this server (e.g. cloudflared tunnel).
# Redirect URI registered in the portal must be: ${PUBLIC_BASE_URL}/auth/callback
PUBLIC_BASE_URL=http://localhost:3001
PORT=3001
